@model List<Category>
@{
    ViewData["Title"] = "Kategory Listesi";
    Layout            = "~/Views/Layout/Index.cshtml";

    int count = 0;
}

<div class="row">
    <div class="col-lg-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h3 class="card-title">Kategori Listesi</h3>
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Kategori Adı</th>
                                <th>Durum</th>
                                <th>Sil</th>
                                <th>Güncelle</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var category in Model)
                            {
                                count++;
                                <tr>
                                    <td>@count</td>
                                    <td>@category.Name</td>
                                    <td><label class="badge @(category.Status ? "badge-success" : "badge-danger") badge-pill">@(category.Status ? "Aktif Kategori" : "Pasif Kategori")</label></td>
                                    <td><a href="/Category/DeleteCategory/@category.CategoryID" class="btn btn-danger">Sil</a></td>
                                    <td><a href="/Category/UpdateCategory/@category.CategoryID" class="btn btn-warning">Güncelle</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <a href="/Category/CreateCategory" class="btn btn-primary">Yeni Kategori Girişi</a>
                </div>
            </div>
        </div>
    </div>
</div>