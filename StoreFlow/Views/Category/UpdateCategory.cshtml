@model Category
@{
    ViewData["Title"] = "Kategory Güncelleme Sayfası";
    Layout            = "~/Views/Layout/Index.cshtml";
}

<div class="row">
    <div class="col-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Kategori Güncelleme Sayfası</h4>
                <form class="forms-sample" method="post">
                    <input type="hidden" asp-for="CategoryID" />
                    <div class="form-group">
                        <label for="exampleInputName1">Kategori Adı</label>
                        <input type="text" class="form-control" id="exampleInputName1" placeholder="Kategori Adını Yazınız" asp-for="Name">
                    </div>
                    <div class="form-group">
                        <label for="exampleInputName1">Kategori Durumu</label>
                        <select class="form-control" asp-for="Status">
                            <option selected="selected" disabled>Kategori Durumu</option>
                            <option value="true">Aktif Yap</option>
                            <option value="false">Pasif Yap</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary mr-2">Kategoriyi Güncelle</button>
                </form>
            </div>
        </div>
    </div>
</div>