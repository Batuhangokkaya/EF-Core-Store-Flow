@model Category
@{
    ViewData["Title"] = "Kategory Ekleme Sayfası";
    Layout            = "~/Views/Layout/Index.cshtml";
}

<div class="row">
    <div class="col-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h3 class="mb-1">Yeni Kategori Ekle</h3>
                        <p class="text-muted mb-0">
                            Sisteme yeni bir kategori eklemek için gerekli bilgileri doldurunuz.
                        </p>
                    </div>
                    <span class="badge badge-primary p-2">
                        Yeni Kayıt
                    </span>
                </div>
                <form class="forms-sample" method="post">
                    <div class="form-group">
                        <label for="exampleInputName1">Kategori Adı</label>
                        <input type="text" class="form-control" id="exampleInputName1" placeholder="Kategori Adını Yazınız" asp-for="Name">
                    </div>
                    <button type="submit" class="btn btn-primary mr-2">Kategoriyi Ekle</button>
                    <a href="/Category/CategoryList" class="btn btn-light">Vazgeç</a>
                </form>
            </div>
        </div>
    </div>
</div>