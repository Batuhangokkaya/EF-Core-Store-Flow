@model Message
@{
    ViewData["Title"] = "Mesaj Detayı";
    Layout            = "~/Views/Layout/Index.cshtml";
}

<div class="row">
    <div class="col-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <div class="mb-4">
                    <a href="/Message/Index" class="btn btn-light"><i class="fas fa-arrow-left mr-1"></i>Geri Dön</a>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h3 class="mb-1">Mesaj Detayı</h3>
                        <p class="text-muted mb-0">Gönderilen mesaja ait tüm bilgiler aşağıda yer almaktadır.</p>
                    </div>
                    @if (Model.IsRead)
                    {
                        <span class="badge badge-success p-2">Okundu</span>
                    }
                    else
                    {
                        <span class="badge badge-warning p-2">Okunmadı</span>
                    }
                </div>
                <div class="row">
                    <div class="col-md-3 mb-4">
                        <div class="text-center border rounded p-3 h-100">
                            <img src="@Model.SenderImageURL" alt="@Model.SenderNameSurname" class="rounded-circle mb-3" style="width:120px; height:120px; object-fit:cover;" />
                            <h5 class="mb-1">@Model.SenderNameSurname</h5>
                            <p class="text-muted mb-0">Mesaj Gönderen</p>
                        </div>
                    </div>
                    <div class="col-md-9">
                        <div class="form-group">
                            <label>Mesaj Başlığı</label>
                            <input type="text" value="@Model.Title" class="form-control" readonly />
                        </div>
                        <div class="form-group">
                            <label>Gönderilme Tarihi</label>
                            <input type="text" value="@Model.DateTime.ToString("dd.MM.yyyy HH:mm")" class="form-control" readonly />
                        </div>
                        <div class="form-group">
                            <label>Mesaj Detayı</label>
                            <textarea class="form-control" rows="10" readonly>@Model.Detail</textarea>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>