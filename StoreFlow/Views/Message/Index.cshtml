@model List<Message>
@{
    ViewData["Title"] = "Mesaj Listesi";
    Layout            = "~/Views/Layout/Index.cshtml";

    int count = 0;
}

<div class="row">
    <div class="col-lg-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h3 class="mb-1">Mesaj Listesi</h3>
                        <p class="text-muted mb-0">
                            İletişim formu üzerinden gönderilen tüm mesajları görüntüleyebilir, detaylarını inceleyebilirsiniz.
                        </p>
                    </div>
                    <div class="d-flex align-items-center">
                        <span class="badge badge-primary p-2 mr-2">
                            Gelen Kutusu
                        </span>
                        <span class="badge badge-info p-2">
                            @Model.Count Mesaj
                        </span>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Görsel</th>
                                <th>Gönderen</th>
                                <th>Konu</th>
                                <th>Durum</th>
                                <th>Tarih</th>
                                <th>Sil</th>
                                <th>Mesajı Aç</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var message in Model)
                            {
                                count++;
                                <tr>
                                    <td>@count</td>
                                    <td><img src="@message.SenderImageURL" /></td>
                                    <td>@message.SenderNameSurname</td>
                                    <td>@message.Title</td>
                                    <td>@(message.IsRead == false ? "Okunmadı" : "Okundu")</td>
                                    <td>@message.DateTime</td>
                                    <td><a href="/Message/DeleteMessage/@message.MessageID" class="btn btn-danger">Sil</a></td>
                                    <td><a href="/Message/MessageDetail/@message.MessageID" class="btn btn-success">Mesajı Aç</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>