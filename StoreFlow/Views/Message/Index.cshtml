@model List<Message>
@{
    ViewData["Title"] = "Mesaj Listesi";
    Layout            = "~/Views/Layout/Index.cshtml";

    int count = 0;
}

<div class="row">
    <div class="col-lg-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h3 class="card-title">Mesaj Listesi</h3>
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Görsel</th>
                                <th>Gönderen</th>
                                <th>Konu</th>
                                <th>Durum</th>
                                <th>Tarih</th>
                                <th>Sil</th>
                                <th>Güncelle</th>
                                <th>Mesajı Aç</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var message in Model)
                            {
                                count++;
                                <tr>
                                    <td>@count</td>
                                    <td>@message.SenderImageURL</td>
                                    <td>@message.SenderNameSurname</td>
                                    <td>@message.Title</td>
                                    <td>@message.IsRead</td>
                                    <td>@message.DateTime</td>
                                    <td><a href="/Message/DeleteMessage/@message.MessageID" class="btn btn-danger">Sil</a></td>
                                    <td><a href="/Message/UpdateMessage/@message.MessageID" class="btn btn-warning">Güncelle</a></td>
                                    <td><a href="/Message/UpdateMessage/@message.MessageID" class="btn btn-success">Mesajı Aç</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <a href="/Message/CreateMessage" class="btn btn-primary">Yeni Mesaj Girişi</a>
                </div>
            </div>
        </div>
    </div>
</div>