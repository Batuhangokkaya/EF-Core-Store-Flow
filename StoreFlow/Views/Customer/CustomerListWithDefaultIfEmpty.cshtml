@model List<Customer>
@{
    ViewData["Title"] = "Varsayılan Müşteri Kaydı";
    Layout            = "~/Views/Layout/Index.cshtml";

    int count = 0;
}

<div class="row">
    <div class="col-lg-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h3 class="mb-1">Varsayılan Müşteri Kaydı</h3>
                        <p class="text-muted mb-0">
                            Seçilen şehirde müşteri bulunamazsa, DefaultIfEmpty() metodu kullanılarak varsayılan bir kayıt gösterilmektedir.
                        </p>
                    </div>
                    <span class="badge badge-primary p-2">
                        DefaultIfEmpty()
                    </span>
                </div>
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th style="width: 33%;">#</th>
                                <th style="width: 33%;">Müşteri Adı Soyadı</th>
                                <th style="width: 33%;">Şehir</th>
                                <th>Bakiye</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var customer in Model)
                            {
                                count++;
                                <tr>
                                    <td>@count</td>
                                    <td>@customer.Name @customer.Surname</td>
                                    <td>@customer.City</td>
                                    <td style="font-family: Calibri">@customer.Balance₺</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>