@model List<string>
@{
    ViewData["Title"] = "Müşteri Cast Örneği";
    Layout            = "~/Views/Layout/Index.cshtml";

    int count = 0;
}

<div class="row">
    <div class="col-lg-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h3 class="mb-1">Müşteri Cast Örneği</h3>
                        <p class="text-muted mb-0">
                            Object türündeki müşteri verileri Cast() metodu kullanılarak Customer türüne dönüştürülmektedir.
                        </p>
                    </div>
                    <span class="badge badge-primary p-2">
                        Cast()
                    </span>
                </div>
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th style="width: 50%;">#</th>
                                <th style="width: 50%;">Müşteri Adı Soyadı</th>
                                <th>Şehir</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var customer in ((IEnumerable<object>)ViewBag.Customers).Cast<Customer>())
                            {
                                count++;
                                <tr>
                                    <td>@count</td>
                                    <td>@customer.Name @customer.Surname</td>
                                    <td>@customer.City</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>