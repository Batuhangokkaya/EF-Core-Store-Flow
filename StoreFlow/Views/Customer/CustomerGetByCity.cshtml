@{
    ViewData["Title"] = "Şehre Göre Müşteri Sorgulama";
    Layout            = "~/Views/Layout/Index.cshtml";
}

<div class="row">
    <div class="col-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h3 class="mb-1">Şehirde Müşteri Sorgulama</h3>
                        <p class="text-muted mb-0">
                            Girilen şehirde kayıtlı müşteri bulunup bulunmadığı kontrol edilmektedir.
                        </p>
                    </div>
                    <span class="badge badge-primary p-2">
                        Any()
                    </span>
                </div>
                <form class="forms-sample" method="get" asp-action="CustomerGetByCity">
                    <div class="form-group">
                        <label for="exampleInputName1">Şehir Adı Giriniz</label>
                        <input type="text" class="form-control" id="exampleInputName1" name="city" placeholder="Şehir Adını Yazınız" required>
                    </div>
                    <button type="submit" class="btn btn-primary mr-2">Müşteriyi Kontrol Et</button>
                </form>
                <br />
                <div class="alert alert-success">@ViewBag.Message</div>
            </div>
        </div>
    </div>
</div>