@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Müşteri Listesi - Index";
    Layout            = "~/Views/Layout/Index.cshtml";

    int count = 0;
}

<div class="row">
    <div class="col-lg-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h3 class="mb-1">İndeksli Müşteri Listesi</h3>
                        <p class="text-muted mb-0">
                            Müşteriler, Select() metodunun indeks parametresi kullanılarak sıra numarası ile birlikte listelenmektedir.
                        </p>
                    </div>
                    <span class="badge badge-primary p-2">
                        Select(Index)
                    </span>
                </div>
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th style="width: 30%;">#</th>
                                <th style="width: 30%;">Müşteri Adı</th>
                                <th style="width: 30%;">Müşteri Soyadı</th>
                                <th>Müşteri Şehri</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var customer in Model)
                            {
                                count++;
                                <tr>
                                    <td>@count</td>
                                    <td>@customer.Name</td>
                                    <td>@customer.Surname</td>
                                    <td>@customer.City</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>