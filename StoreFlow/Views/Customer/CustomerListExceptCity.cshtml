@model List<Customer>

@{
    ViewData["Title"] = "Şehir Hariç Müşteri Listesi";
    Layout            = "~/Views/Layout/Index.cshtml";

    int count = 0;
}

<div class="row">
    <div class="col-lg-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h3 class="mb-1">Seçilen Şehir Hariç Müşteri Listesi</h3>
                        <p class="text-muted mb-0">
                            Seçilen şehirde bulunan müşteriler ExceptBy() metodu kullanılarak listeden çıkarılmıştır.
                        </p>
                    </div>
                    <span class="badge badge-primary p-2">
                        ExceptBy()
                    </span>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0">
                        @if (string.IsNullOrWhiteSpace(ViewBag.SelectedCity))
                        {
                            <span>Tüm Müşteriler</span>
                        }
                        else
                        {
                            <span>@ViewBag.SelectedCity Hariç Müşteriler</span>
                        }
                    </h5>
                    <form method="get" asp-controller="Customer" asp-action="CustomerListExceptCity">
                        <select name="city" class="form-control" style="width: 280px;" onchange="this.form.submit()">

                            <option value="" disabled>Hariç Tutulacak Şehri Seçiniz</option>

                            @foreach (var city in ViewBag.CityList)
                            {
                                <option value="@city" selected="@(ViewBag.SelectedCity == city ? "selected" : null)">@city</option>
                            }
                        </select>
                    </form>
                </div>
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th style="width: 30%;">#</th>
                                <th style="width: 30%;">Müşteri Adı Soyadı</th>
                                <th style="width: 30%;">Şehir</th>
                                <th>Bakiye</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var customer in Model)
                            {
                                count++;
                                <tr>
                                    <td>@count</td>
                                    <td>@customer.Name @customer.Surname</td>
                                    <td>@customer.City</td>
                                    <td style="font-family: Calibri;">@customer.Balance₺</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>