@model List<string>

@{
    ViewData["Title"] = "Ortak Müşteriler (Intersect)";
    Layout            = "~/Views/Layout/Index.cshtml";

    int count = 0;
}

<div class="row">
    <div class="col-lg-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h3 class="mb-1">Ortak Müşteriler (Intersect)</h3>
                        <p class="text-muted mb-0">
                            İstanbul ve Trabzon şehirlerindeki müşteri listelerinin kesişim kümesi gösterilmektedir.
                        </p>
                    </div>
                    <span class="badge badge-primary p-2">
                        Intersect()
                    </span>
                </div>
                @if (Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th style="width: 5%;">#</th>
                                    <th>Müşteri Adı Soyadı</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var customer in Model)
                                {
                                    count++;
                                    <tr>
                                        <td>@count</td>
                                        <td>@customer</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning mb-0">
                        İstanbul ve Trabzon şehirlerinde ortak müşteri bulunamadı.
                    </div>
                }
            </div>
        </div>
    </div>
</div>