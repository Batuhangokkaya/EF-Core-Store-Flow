@model Customer
@{
    ViewData["Title"] = "Müşteri Güncelle";
    Layout            = "~/Views/Layout/Index.cshtml";
}

<div class="row">
    <div class="col-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h3 class="mb-1">Müşteri Güncelle</h3>
                        <p class="text-muted mb-0">
                            Seçilen müşteriye ait bilgileri düzenleyip kaydedebilirsiniz.
                        </p>
                    </div>
                    <span class="badge badge-primary p-2">
                        Güncelleme
                    </span>
                </div>
                <form method="post" asp-controller="Customer" asp-action="UpdateCustomer" class="forms-sample">
                    <input type="hidden" asp-for="CustomerID" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3">
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Name">Müşteri Adı</label>
                                <input asp-for="Name" class="form-control" placeholder="Müşteri adını giriniz" />
                                <span asp-validation-for="Name" class="text-danger">
                                </span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Surname">Müşteri Soyadı</label>
                                <input asp-for="Surname" class="form-control" placeholder="Müşteri soyadını giriniz" />
                                <span asp-validation-for="Surname" class="text-danger">
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="City">Şehir</label>
                                <input asp-for="City" class="form-control" placeholder="Şehir adını giriniz" />
                                <span asp-validation-for="City" class="text-danger">
                                </span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="District">İlçe</label>
                                <input asp-for="District" class="form-control" placeholder="İlçe adını giriniz" />
                                <span asp-validation-for="District" class="text-danger">
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label asp-for="Balance">Bakiye</label>
                        <input asp-for="Balance" type="number" step="0.01" min="0" class="form-control" placeholder="Müşteri bakiyesini giriniz" />
                        <span asp-validation-for="Balance" class="text-danger"> </span>
                    </div>
                    <div class="form-group">
                        <label asp-for="ImageURL">Görsel URL</label>
                        <input asp-for="ImageURL" class="form-control" placeholder="Müşteri görselinin URL adresini giriniz" />
                        <span asp-validation-for="ImageURL" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-primary mr-2">Müşteriyi Güncelle</button>
                    <a href="/Customer/ListCustomer" class="btn btn-light">Vazgeç</a>
                </form>
            </div>
        </div>
    </div>
</div>