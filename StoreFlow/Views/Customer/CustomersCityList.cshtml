@model List<string>
@{
    ViewData["Title"] = "Tekrarsız Şehir Listesi";
    Layout            = "~/Views/Layout/Index.cshtml";

    int count = 0;
}

<div class="row">
    <div class="col-lg-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h3 class="mb-1">Tekrarsız Şehir Listesi</h3>
                        <p class="text-muted mb-0">
                            Sistemde kayıtlı müşterilere ait tekrar etmeyen şehirler listelenmektedir.
                        </p>
                    </div>
                    <span class="badge badge-primary p-2">
                        @Model.Count Şehir
                    </span>
                </div>
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th style="width: 5%;">#</th>
                                <th>Şehir Adı</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var customer in Model)
                            {
                                count++;
                                <tr>
                                    <td>@count</td>
                                    <td>@customer</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>