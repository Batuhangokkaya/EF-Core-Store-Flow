@model List<Order>
@{
    string status = "";
}

<div class="col-md-8 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">
                <i class="fas fa-table"></i>
                Son Siparişler
            </h4>
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Müşteri</th>
                            <th>Ürün</th>
                            <th>Adet</th>
                            <th>Durum</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td class="font-weight-bold">
                                    @order.Customer.Name @order.Customer.Surname
                                </td>
                                <td class="text-muted">
                                    @order.Product.Name
                                </td>
                                <td>
                                    @order.OrderCount
                                </td>
                                @switch (order.Status)
                                {
                                    case "Taşıma Durumunda":
                                        <td>
                                            <label class="badge badge-warning badge-pill">@order.Status</label>
                                        </td>
                                        break;
                                    case "İptal Edildi":
                                        <td>
                                            <label class="badge badge-danger badge-pill">@order.Status</label>
                                        </td>
                                        break;
                                    case "Teslim Edildi":
                                        <td>
                                            <label class="badge badge-success badge-pill">@order.Status</label>
                                        </td>
                                        break;
                                    case "Sipariş Alındı":
                                        <td>
                                            <label class="badge badge-primary badge-pill">@order.Status</label>
                                        </td>
                                        break;
                                    case "Ödeme Bekleniyor":
                                        <td>
                                            <label class="badge badge-secondary badge-pill">@order.Status</label>
                                        </td>
                                        break;
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="col-md-4 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">
                <i class="fas fa-calendar-alt"></i>
                Takvim
            </h4>
            <div id="inline-datepicker-example" class="datepicker"></div>
        </div>
    </div>
</div>