<div class="content-wrapper">
    <div class="row">
        <div class="col-md-4 grid-margin">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title mb-0">Kategori Sayısı</h4>
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="d-inline-block pt-3">
                            <div class="d-md-flex">
                                <h2 class="mb-0">@ViewBag.CategoryCount</h2>
                            </div>
                            <small class="text-gray">Toplamda @ViewBag.CategoryCount kategori bulunuyor.</small>
                        </div>
                        <div class="d-inline-block">
                            <i class="fas fa-database text-info icon-lg"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4 grid-margin">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title mb-0">En Yüksek Ürün Fiyatı</h4>
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="d-inline-block pt-3">
                            <div class="d-md-flex">
                                <h2 class="mb-0" style="font-family: Calibri">@string.Format("{0:N2}", ViewBag.ProductMaxPrice)₺</h2>
                            </div>
                            <small class="text-gray">Bu Ürün: @ViewBag.ProductMaxPriceProductName</small>
                        </div>
                        <div class="d-inline-block">
                            <i class="fas fa-coins text-success icon-lg"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4 grid-margin">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title mb-0">En Düşük Ürün Fiyatı</h4>
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="d-inline-block pt-3">
                            <div class="d-md-flex">
                                <h2 class="mb-0" style="font-family: Calibri">@ViewBag.ProductMinPrice₺</h2>
                            </div>
                            <small class="text-gray">Bu Ürün: @ViewBag.ProductMinPriceProductName</small>
                        </div>
                        <div class="d-inline-block">
                            <i class="fas fa-coins text-danger icon-lg"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-4 grid-margin">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title mb-0">Toplam Ürün Stok Sayısı</h4>
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="d-inline-block pt-3">
                            <div class="d-md-flex">
                                <h2 class="mb-0">@ViewBag.TotalSumProductStock</h2>
                            </div>
                            <small class="text-gray">Stokta @ViewBag.TotalSumProductStock ürün bulunuyor.</small>
                        </div>
                        <div class="d-inline-block">
                            <i class="fas fa-boxes text-warning icon-lg"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4 grid-margin">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title mb-0">Ortalama Ürün Stok Sayısı</h4>
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="d-inline-block pt-3">
                            <div class="d-md-flex">
                                <h2 class="mb-0" style="font-family: Calibri">@string.Format("{0:N3}", ViewBag.AverageProductStock)₺</h2>
                            </div>
                            <small class="text-gray">Toplam Ürün Stok Sayısı / Ürün Adet Değeri</small>
                        </div>
                        <div class="d-inline-block">
                            <i class="fas fa-cubes icon-lg" style="color:#6f42c1"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4 grid-margin">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title mb-0">Ortalama Ürün Fiyatı</h4>
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="d-inline-block pt-3">
                            <div class="d-md-flex">
                                <h2 class="mb-0" style="font-family: Calibri">@string.Format("{0:N2}", ViewBag.AverageProductPrice)₺</h2>
                            </div>
                            <small class="text-gray">1 Adet ürün için ortalama fiyat</small>
                        </div>
                        <div class="d-inline-block">
                            <i class="fas fa-coins text-info icon-lg"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-4 grid-margin">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title mb-0">1000 TL'den Yüksek Fiyatlı Ürün Sayısı</h4>
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="d-inline-block pt-3">
                            <div class="d-md-flex">
                                <h2 class="mb-0">@ViewBag.BiggerPriceThen1000ProductCount</h2>
                            </div>
                            <small class="text-gray">Fiyatı 1000 TL'den Yüksek Sayısı.</small>
                        </div>
                        <div class="d-inline-block">
                            <i class="fas fa-money-bill-wave text-success icon-lg"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4 grid-margin">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title mb-0">4 Nolu ID'ye Ait Ürün Adı</h4>
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="d-inline-block pt-3">
                            <div class="d-md-flex">
                                <h2 class="mb-0">@ViewBag.GetIDIs4ProductName</h2>
                            </div>
                            <small class="text-gray">ID Değeri 4 Olan Ürün Adı</small>
                        </div>
                        <div class="d-inline-block">
                            <i class="fas fa-hashtag text-primary icon-lg"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4 grid-margin">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title mb-0">Stoğu 50-100 Arasındaki Ürün</h4>
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="d-inline-block pt-3">
                            <div class="d-md-flex">
                                <h2 class="mb-0">@ViewBag.StockCountBigger50AndSmaller100ProductCount</h2>
                            </div>
                            <small class="text-gray">Stok sayısı 50'den büyük 100'den küçük ürün</small>
                        </div>
                        <div class="d-inline-block">
                            <i class="fas fa-box-open text-warning icon-lg"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-4 grid-margin">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title mb-0">Toplam Müşteri Sayısı</h4>
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="d-inline-block pt-3">
                            <div class="d-md-flex">
                                <h2 class="mb-0">@ViewBag.CustomerCount</h2>
                            </div>
                            <small class="text-gray">Toplamda @ViewBag.CustomerCount Müşteri Bulunuyor.</small>
                        </div>
                        <div class="d-inline-block">
                            <i class="fas fa-users text-info text-success icon-lg"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4 grid-margin">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title mb-0">Toplam Sipariş Sayısı</h4>
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="d-inline-block pt-3">
                            <div class="d-md-flex">
                                <h2 class="mb-0">@ViewBag.OrderCount</h2>
                            </div>
                            <small class="text-gray">Toplamda @ViewBag.OrderCount Müşteri Bulunuyor.</small>
                        </div>
                        <div class="d-inline-block">
                            <i class="fas fa-shopping-cart text-success icon-lg"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4 grid-margin">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title mb-0">Bakiyesi En Yüksek Müşteri</h4>
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="d-inline-block pt-3">
                            <div class="d-md-flex">
                                <h2 class="mb-0">@ViewBag.HighestBalanceCustomer</h2>
                            </div>
                            <small class="text-gray" style="font-family: Calibri;">Bakiye: @ViewBag.HighestBalance.ToString("N2")₺</small>
                        </div>
                        <div class="d-inline-block">
                            <i class="fas fa-wallet text-success icon-lg"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>