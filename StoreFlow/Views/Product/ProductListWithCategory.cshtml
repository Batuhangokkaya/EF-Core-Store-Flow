@model List<ProductWithCategoryViewModel>
@{
    ViewData["Title"] = "Ürün Listesi Kategorileri İle";
    Layout            = "~/Views/Layout/Index.cshtml";

    int count = Model.Count + 1;
}

<div class="row">
    <div class="col-lg-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h3 class="card-title">Ürün Listesi Kategorileri İle</h3>
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Ürün Adı</th>
                                <th>Stok Sayısı</th>
                                <th>Kategori Adı</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var product in Model)
                            {
                                count--;
                                <tr>
                                    <td>@count</td>
                                    <td>@product.ProductName</td>
                                    <td>@product.ProductStock</td>
                                    <td>@product.CategoryName</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
