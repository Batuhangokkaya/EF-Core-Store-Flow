@model List<ProductWithCategoryViewModel>
@{
    ViewData["Title"] = "Kategorileriyle Ürün Listesi";
    Layout            = "~/Views/Layout/Index.cshtml";

    int count = Model.Count + 1;
}

<div class="row">
    <div class="col-lg-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h3 class="mb-1">Kategorileriyle Ürün Listesi</h3>
                        <p class="text-muted mb-0">
                            Ürünler, ait oldukları kategorilerle birlikte listelenmektedir.
                        </p>
                    </div>
                    <div class="d-flex align-items-center">
                        <span class="badge badge-primary p-2 mr-2">
                            Include()
                        </span>
                        <span class="badge badge-info p-2">
                            @Model.Count Ürün
                        </span>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th style="width: 30%;">#</th>
                                <th style="width: 30%;">Ürün Adı</th>
                                <th style="width: 30%;">Stok Sayısı</th>
                                <th>Kategori Adı</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var product in Model)
                            {
                                count--;
                                <tr>
                                    <td>@count</td>
                                    <td>@product.ProductName</td>
                                    <td>@product.ProductStock</td>
                                    <td>@product.CategoryName</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
