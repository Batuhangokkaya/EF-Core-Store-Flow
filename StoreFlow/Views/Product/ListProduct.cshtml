@model List<Product>
@{
    ViewData["Title"] = "Ürün Listesi";
    Layout            = "~/Views/Layout/Index.cshtml";

    int count = Model.Count + 1;
}

<div class="row">
    <div class="col-lg-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h3 class="mb-1">Ürün Listesi</h3>
                        <p class="text-muted mb-0">
                            Sistemde kayıtlı tüm ürünler fiyat bilgileriyle birlikte listelenmektedir.
                        </p>
                    </div>
                    <div class="d-flex align-items-center">
                        <span class="badge badge-primary p-2 mr-2">
                            @Model.Count Ürün
                        </span>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th style="width: 20%;">#</th>
                                <th style="width: 20%;">Ürün Adı</th>
                                <th style="width: 20%;">Fiyat</th>
                                <th style="width: 20%;">Kategori Adı</th>
                                <th style="width: 20%;">Stok Sayısı</th>
                                <th>Sil</th>
                                <th>Güncelle</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var product in Model)
                            {
                                count--;
                                <tr>
                                    <td>@count</td>
                                    <td>@product.Name</td>
                                    <td style="font-family: Calibri">@product.Price₺</td>
                                    <td>@product.Category.Name</td>
                                    <td>@product.Stock</td>
                                    <td><a href="/product/DeleteProduct/@product.ProductID" class="btn btn-danger">Sil</a></td>
                                    <td><a href="/product/UpdateProduct/@product.ProductID" class="btn btn-warning">Güncelle</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <a href="/product/CreateProduct" class="btn btn-primary">Yeni Ürün Girişi</a>
                </div>
            </div>
        </div>
    </div>
</div>