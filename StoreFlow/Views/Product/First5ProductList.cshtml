@model List<Product>
@{
    ViewData["Title"] = "İlk 5 Ürün Listesi";
    Layout = "~/Views/Layout/Index.cshtml";

    int count = 0;
}

<div class="row">
    <div class="col-lg-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h3 class="card-title">İlk 5 Ürün Listesi</h3>
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Ürün Adı</th>
                                <th>Fiyat</th>
                                <th>Kategori Adı</th>
                                <th>Stok Sayısı</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var product in Model)
                            {
                                count++;
                                <tr>
                                    <td>@count</td>
                                    <td>@product.Name</td>
                                    <td style="font-family: Calibri">@product.Price₺</td>
                                    <td>@product.Category.Name</td>
                                    <td>@product.Stock</td>
                                    <td><a href="/product/DeleteProduct/@product.ProductID" class="btn btn-danger">Sil</a></td>
                                    <td><a href="/product/UpdateProduct/@product.ProductID" class="btn btn-warning">Güncelle</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <a href="/product/CreateProduct" class="btn btn-primary">Yeni Ürün Girişi</a>
                </div>
            </div>
        </div>
    </div>
</div>