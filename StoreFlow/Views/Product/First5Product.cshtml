@model List<Product>
@{
    ViewData["Title"] = "İlk 5 Ürün Listesi";
    Layout            = "~/Views/Layout/Index.cshtml";

    int count = 0;
}

<div class="row">
    <div class="col-lg-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h3 class="mb-1">İlk 5 Ürün</h3>
                        <p class="text-muted mb-0">
                            Take(5) metodu kullanılarak ilk beş ürün listelenmektedir.
                        </p>
                    </div>
                    <div class="d-flex align-items-center">
                        <span class="badge badge-primary p-2 mr-2">
                            Take(5)
                        </span>
                        <span class="badge badge-info p-2">
                            @Model.Count Ürün
                        </span>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th style="width: 23%;">#</th>
                                <th style="width: 23%;">Ürün Adı</th>
                                <th style="width: 23%;">Fiyat</th>
                                <th style="width: 23%;">Kategori Adı</th>
                                <th>Stok Sayısı</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var product in Model)
                            {
                                count++;
                                <tr>
                                    <td>@count</td>
                                    <td>@product.Name</td>
                                    <td style="font-family: Calibri;">@product.Price₺</td>
                                    <td>@product.Category.Name</td>
                                    <td>@product.Stock</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>