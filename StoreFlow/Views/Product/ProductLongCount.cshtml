@{
    ViewData["Title"] = "Ürün İstatistikleri";
    Layout            = "~/Views/Layout/Index.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="mb-1">Ürün İstatistikleri</h3>
        <p class="text-muted mb-0">
            LongCount() metodu kullanılarak toplam ürün sayısı hesaplanmış ve son eklenen ürün bilgisi gösterilmektedir.
        </p>
    </div>
    <span class="badge badge-primary p-2">
        LongCount()
    </span>
</div>
<div class="row">
    <div class="col-md-6 grid-margin stretch-card">
        <div class="card">
            <div class="card-body text-center">
                <h5 class="text-muted">Toplam Ürün</h5>
                <h1 class="font-weight-bold text-primary">
                    @ViewBag.Value
                </h1>
            </div>
        </div>
    </div>
    <div class="col-md-6 grid-margin stretch-card">
        <div class="card">
            <div class="card-body text-center">
                <h5 class="text-muted">Son Eklenen Ürün</h5>
                <h3 class="font-weight-bold text-primary">
                    @ViewBag.LastProduct
                </h3>
            </div>
        </div>
    </div>
</div>