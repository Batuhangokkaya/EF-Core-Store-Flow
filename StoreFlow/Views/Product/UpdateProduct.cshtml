@model Product
@{
    ViewData["Title"] = "Ürün Güncelleme Sayfası";
    Layout            = "~/Views/Layout/Index.cshtml";
}

<div class="row">
    <div class="col-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h3 class="mb-1">Ürün Bilgilerini Güncelle</h3>
                        <p class="text-muted mb-0">
                            Seçilen ürüne ait bilgileri düzenleyerek değişiklikleri kaydedebilirsiniz.
                        </p>
                    </div>

                    <div class="d-flex align-items-center">
                        <span class="badge badge-warning p-2 mr-2">
                            Güncelleme
                        </span>

                        <span class="badge badge-info p-2">
                            Attach
                        </span>
                    </div>
                </div>
                <form class="forms-sample" method="post">
                    <input type="hidden" asp-for="ProductID"/>
                    <div class="form-group">
                        <label for="exampleInputName1">Kategori Adı</label>
                        <input type="text" class="form-control" id="exampleInputName1" placeholder="Ürün Adını Yazınız" asp-for="Name">
                    </div>
                    <div class="form-group">
                        <label for="exampleInputName1">Ürün Fiyatı</label>
                        <input type="text" class="form-control" id="exampleInputName1" placeholder="Ürün Fiyatını Giriniz" asp-for="Price">
                    </div>
                    <div class="form-group">
                        <label for="exampleInputName1">Kategori Seçiniz</label>
                        <select class="form-control" asp-for="CategoryID" asp-items="@ViewBag.Categories">
                            <option selected="selected" disabled>Kategori Adı Seçiniz</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="exampleInputName1">Stok Sayısı</label>
                        <input type="number" class="form-control" id="exampleInputName1" placeholder="Stok Sayısını Giriniz" asp-for="Stock">
                    </div>
                    <button type="submit" class="btn btn-primary mr-2">Ürünü Güncelle</button>
                    <a href="/Product/ListProduct" class="btn btn-light">Vazgeç</a>
                </form>
            </div>
        </div>
    </div>
</div>