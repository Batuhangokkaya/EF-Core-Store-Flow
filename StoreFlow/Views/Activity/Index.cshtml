@model List<Activity>
@{
    ViewData["Title"] = "Aktivite Listesi";
    Layout            = "~/Views/Layout/Index.cshtml";

    int count = 0;
}

<div class="row">
    <div class="col-lg-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h3 class="mb-1">Aktivite Listesi</h3>
                        <p class="text-muted mb-0">
                            Günlük plan ve aktiviteleri görüntüleyebilir, düzenleyebilir veya silebilirsiniz.
                        </p>
                    </div>
                    <div class="d-flex align-items-center">
                        <span class="badge badge-info p-2 mr-2">
                            @Model.Count Aktivite
                        </span>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th style="width: 25%;">#</th>
                                <th style="width: 25%;">Başlık</th>
                                <th style="width: 25%;">Açıklama</th>
                                <th style="width: 25%;">Saat</th>
                                <th>Sil</th>
                                <th>Güncelle</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var activity in Model)
                            {
                                count++;
                                <tr>
                                    <td>@count</td>
                                    <td>@activity.Title</td>
                                    <td>@activity.Description</td>
                                    <td>
                                        <span class="badge badge-primary badge-pill">
                                            @activity.Time.ToString(@"hh\:mm")
                                        </span>
                                    </td>
                                    <td class="text-right"><a href="/Activity/Delete/@activity.ActivityID" class="btn btn-sm btn-danger">Sil</a></td>
                                    <td class="text-right"><a href="/Activity/Update/@activity.ActivityID" class="btn btn-sm btn-warning mr-1">Güncelle</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <a href="Activity/Create" class="btn btn-primary">Yeni Aktivite Ekle</a>
                </div>
            </div>
        </div>
    </div>
</div>