@model Order
@{
    ViewData["Title"] = "Sipariş Oluşturma Sayfası";
    Layout            = "~/Views/Layout/Index.cshtml";
}

<div class="row">
    <div class="col-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Yeni Sipariş Oluşturma Sayfası</h4>
                <form class="forms-sample" method="post">
                    <div class="form-group">
                        <label for="exampleInputName1">Ürün Seçiniz</label>
                        <select class="form-control" asp-for="ProductID" asp-items="@ViewBag.Products">
                            <option selected="selected" disabled>Ürün Adı Seçiniz</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="exampleInputName1">Müşteri Seçiniz</label>
                        <select class="form-control" asp-for="CustomerID" asp-items="@ViewBag.Customers">
                            <option selected="selected" disabled>Müşteri Adı Seçiniz</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="exampleInputName1">Sipariş Adet</label>
                        <input type="text" class="form-control" id="exampleInputName1" placeholder="Sipariş Adedini Giriniz" asp-for="OrderCount">
                    </div>
                    <div class="form-group">
                        <label for="exampleInputName1">Birim Fiyat Giriniz</label>
                        <input type="number" class="form-control" id="exampleInputName1" placeholder="Birim Fiyatını Giriniz..." asp-for="UnitPrice">
                    </div>
                    <div class="form-group">
                        <label for="exampleInputName1">Toplam Fiyat Giriniz</label>
                        <input type="number" class="form-control" id="exampleInputName1" placeholder="Toplam Fiyatını Giriniz..." asp-for="TotalPrice">
                    </div>
                    <button type="submit" class="btn btn-primary mr-2">Siparişi Oluştur</button>
                </form>
            </div>
        </div>
    </div>
</div>