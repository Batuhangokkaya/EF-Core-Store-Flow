@model List<Order>
@{
    ViewData["Title"] = "Sipariş Listesi";
    Layout = "~/Views/Layout/Index.cshtml";

    int count = Model.Count + 1;
}

<div class="row">
    <div class="col-lg-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h3 class="card-title">Sipariş Listesi</h3>
                <div class="table-responsive">
                    <form class="form-sample" method="get" asp-action="OrderListSearch">
                        <label>Duruma Göre Arama İşlemi</label>
                        <input type="text" class="form-control" name="name" placeholder="Örnek: Taşıma Durumunda..." />
                        <br /><br />
                        <label>Filtre Tipi</label>
                        <select name="filterType" class="form-control">
                            <option value="Start">Bu harflerle başlıyorsa</option>
                            <option value="End">Bu harflerle bitiyorsa</option>
                        </select>
                        <div style="text-align: end;">
                        <button type="submit" class="btn btn-primary mt-2">Ara</button>
                        </div>
                    </form>
                    <table class="table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Ürün Adı</th>
                                <th>Müşteri</th>
                                <th>Sipariş Adet</th>
                                <th>Birim Fiyat</th>
                                <th>Durum</th>
                                <th>Sil</th>
                                <th>Güncelle</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model)
                            {
                                count--;
                                <tr>
                                    <td>@count</td>
                                    <td>@order.ProductID</td>
                                    <td>@order.CustomerID</td>
                                    <td>@order.OrderCount</td>
                                    <td style="font-family: Calibri">@order.UnitPrice₺</td>
                                    <td>@order.Status</td>
                                    <td><a href="/Order/AsyncDeleteOrder/@order.OrderID" class="btn btn-danger">Sil</a></td>
                                    <td><a href="/Order/AsyncUpdateOrder/@order.OrderID" class="btn btn-warning">Güncelle</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <a href="/Order/Createorder" class="btn btn-primary">Yeni Sipariş Girişi</a>
                </div>
            </div>
        </div>
    </div>
</div>