@model List<Order>
@{
    ViewData["Title"] = "Sipariş Arama";
    Layout = "~/Views/Layout/Index.cshtml";

    int count = Model.Count + 1;
}

<div class="row">
    <div class="col-lg-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h3 class="mb-1">Sipariş Arama</h3>
                        <p class="text-muted mb-0">
                            Girilen anahtar kelimeye göre siparişler filtrelenerek listelenmektedir.
                        </p>
                    </div>
                    <div class="d-flex align-items-center">
                        <span class="badge badge-primary p-2 mr-2">
                            Contains()
                        </span>
                        @if (Model != null)
                        {
                            <span class="badge badge-info p-2">
                                @Model.Count Sonuç
                            </span>
                        }
                    </div>
                </div>
                <div class="table-responsive">
                    <form class="form-sample" method="get" asp-action="OrderListSearch">
                        <label>Duruma Göre Arama İşlemi</label>
                        <input type="text" class="form-control" name="name" placeholder="Örnek: Taşıma Durumunda..." />
                        <br /><br />
                        <label>Filtre Tipi</label>
                        <select name="filterType" class="form-control">
                            <option value="Start">Bu harflerle başlıyorsa</option>
                            <option value="End">Bu harflerle bitiyorsa</option>
                        </select>
                        <div style="text-align: end;">
                        <button type="submit" class="btn btn-primary mt-2">Ara</button>
                        </div>
                    </form>
                    <table class="table">
                        <thead>
                            <tr>
                                <th style="width: 18%;">#</th>
                                <th style="width: 18%;">Ürün Adı</th>
                                <th style="width: 18%;">Müşteri</th>
                                <th style="width: 18%;">Sipariş Adet</th>
                                <th style="width: 18%;">Birim Fiyat</th>
                                <th>Durum</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model)
                            {
                                count--;
                                <tr>
                                    <td>@count</td>
                                    <td>@order.ProductID</td>
                                    <td>@order.CustomerID</td>
                                    <td>@order.OrderCount</td>
                                    <td style="font-family: Calibri">@order.UnitPrice₺</td>
                                    <td>@order.Status</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>