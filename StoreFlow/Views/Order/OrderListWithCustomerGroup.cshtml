@model List<CustomerOrderViewModel>
@{
    ViewData["Title"] = "Müşterilere Göre Sipariş Listesi";
    Layout            = "~/Views/Layout/Index.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="mb-1">Müşterilere Göre Sipariş Listesi</h3>
        <p class="text-muted mb-0">
            Müşteriler, kendilerine ait siparişlerle Group Join işlemi kullanılarak birlikte listelenmektedir..
        </p>
    </div>
    <div class="d-flex align-items-center">
        <span class="badge badge-primary p-2 mr-2">
            GroupJoin()
        </span>
        <span class="badge badge-info p-2">
            @Model.Count Müşteri
        </span>
    </div>
</div>
@foreach(var customerOrderVM in Model)
{
    <div class="card mb-3">
        <div class="card-header bg-dark text-white">
            <strong>@customerOrderVM.CustomerFullName</strong>
        </div>
        <div class="card-body">
            @if (customerOrderVM.Orders.Any())
            {
                <ul class="list-group">
                    @foreach (var order in customerOrderVM.Orders)
                    {
                        <li class="list-group-item">Sipariş No: @order.OrderID</li>
                    }
                </ul>
            }
            else
            {
                <p class="text-muted">Bu müşterinin hiç siparişi yok.</p>
            }
        </div>
    </div>
}