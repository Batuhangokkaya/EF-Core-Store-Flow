@model List<Order>
@{
    ViewData["Title"] = "Asenkron Sipariş Listesi";
    Layout            = "~/Views/Layout/Index.cshtml";

    int count = Model.Count + 1;
}

<div class="row">
    <div class="col-lg-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h3 class="card-title">Asenkron Sipariş Listesi</h3>
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Ürün Adı</th>
                                <th>Müşteri</th>
                                <th>Sipariş Adet</th>
                                <th>Birim Fiyat</th>
                                <th>Toplam Fiyat</th>
                                <th>Durum</th>
                                <th>Sil</th>
                                <th>Güncelle</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model)
                            {
                                count--;
                                <tr>
                                    <td>@count</td>
                                    <td>@order.Product.Name</td>
                                    <td>@order.Customer.Name @order.Customer.Surname</td>
                                    <td>@order.OrderCount</td>
                                    <td style="font-family: Calibri">@order.UnitPrice₺</td>
                                    <td style="font-family: Calibri">@order.TotalPrice₺</td>
                                    <td>@order.Status</td>
                                    <td><a href="/Order/AsyncDeleteOrder/@order.OrderID" class="btn btn-danger">Sil</a></td>
                                    <td><a href="/Order/AsyncUpdateOrder/@order.OrderID" class="btn btn-warning">Güncelle</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <a href="/Order/AsyncCreateOrder" class="btn btn-primary">Yeni Sipariş Girişi</a>
                </div>
            </div>
        </div>
    </div>
</div>