@model List<Order>
@{
    ViewData["Title"] = "Asenkron Sipariş Listesi";
    Layout            = "~/Views/Layout/Index.cshtml";

    int count = Model.Count + 1;
}

<div class="row">
    <div class="col-lg-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h3 class="mb-1">Tüm Siparişler</h3>
                        <p class="text-muted mb-0">
                            Siparişler asenkron olarak veritabanından getirilmekte ve liste halinde gösterilmektedir.
                        </p>
                    </div>

                    <div class="d-flex align-items-center">
                        <span class="badge badge-primary p-2 mr-2">
                            ToListAsync()
                        </span>

                        <span class="badge badge-info p-2">
                            @Model.Count Sipariş
                        </span>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th style="width: 14%;">#</th>
                                <th style="width: 14%;">Ürün Adı</th>
                                <th style="width: 14%;">Müşteri</th>
                                <th style="width: 14%;">Sipariş Adet</th>
                                <th style="width: 14%;">Birim Fiyat</th>
                                <th style="width: 14%;">Toplam Fiyat</th>
                                <th style="width: 14%;">Durum</th>
                                <th>Sil</th>
                                <th>Güncelle</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model)
                            {
                                count--;
                                <tr>
                                    <td>@count</td>
                                    <td>@order.Product.Name</td>
                                    <td>@order.Customer.Name @order.Customer.Surname</td>
                                    <td>@order.OrderCount</td>
                                    <td style="font-family: Calibri">@order.UnitPrice₺</td>
                                    <td style="font-family: Calibri">@order.TotalPrice₺</td>
                                    <td>@order.Status</td>
                                    <td><a href="/Order/AsyncDeleteOrder/@order.OrderID" class="btn btn-danger">Sil</a></td>
                                    <td><a href="/Order/AsyncUpdateOrder/@order.OrderID" class="btn btn-warning">Güncelle</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <a href="/Order/AsyncCreateOrder" class="btn btn-primary">Yeni Sipariş Girişi</a>
                </div>
            </div>
        </div>
    </div>
</div>