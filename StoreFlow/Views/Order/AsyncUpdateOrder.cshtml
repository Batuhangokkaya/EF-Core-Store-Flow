@model Order
@{
    ViewData["Title"] = "Sipariş Güncellene Sayfası";
    Layout            = "~/Views/Layout/Index.cshtml";
}

<div class="row">
    <div class="col-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h3 class="mb-1">Sipariş Güncelle</h3>
                        <p class="text-muted mb-0">
                            Seçilen siparişin bilgilerini düzenleyerek değişiklikleri asenkron olarak kaydedebilirsiniz.
                        </p>
                    </div>
                    <div class="d-flex align-items-center">
                        <span class="badge badge-warning p-2 mr-2">
                            Update()
                        </span>
                        <span class="badge badge-info p-2">
                            SaveChangesAsync()
                        </span>
                    </div>
                </div>
                <form class="forms-sample" method="post">
                    <input type="hidden" asp-for="OrderID" />
                    <div class="form-group">
                        <label for="exampleInputName1">Ürün Seçiniz</label>
                        <select class="form-control" asp-for="ProductID" asp-items="@ViewBag.Products">
                            <option selected="selected" disabled>Ürün Adı Seçiniz</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="exampleInputName1">Müşteri Seçiniz</label>
                        <select class="form-control" asp-for="CustomerID" asp-items="@ViewBag.Customers">
                            <option selected="selected" disabled>Müşteri Adı Seçiniz</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="exampleInputName1">Sipariş Adet</label>
                        <input type="number" class="form-control" id="OrderCount" min="0" placeholder="Sipariş Adedini Giriniz" asp-for="OrderCount">
                    </div>
                    <div class="form-group">
                        <label for="exampleInputName1">Birim Fiyat Giriniz</label>
                        <input type="text" class="form-control" id="UnitPrice" disabled placeholder="Birim Fiyatını Giriniz..." asp-for="UnitPrice">
                    </div>
                    <div class="form-group">
                        <label for="exampleInputName1">Toplam Fiyat Giriniz</label>
                        <input type="text" class="form-control" id="TotalPrice" step="0.01" placeholder="Toplam Fiyatını Giriniz..." asp-for="TotalPrice">
                    </div>
                    <div class="form-group">
                        <label for="exampleInputName1">Sipariş Durumu Seçiniz</label>
                        <select class="form-control" asp-for="Status">
                            <option selected="selected" disabled>Sipariş Durumu Seçiniz</option>
                            <option value="İptal Edildi">İptal Edildi</option>
                            <option value="Taşıma Durumunda">Taşıma Durumunda</option>
                            <option value="Ödeme Bekleniyor">Ödeme Bekleniyor</option>
                            <option value="Sipariş Alındı">Sipariş Alındı</option>
                            <option value="Teslim Edildi">Teslim Edildi</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary mr-2">Siparişi Güncelle</button>
                    <a href="/Order/AsyncOrderList" class="btn btn-light">Vazgeç</a>
                </form>
            </div>
        </div>
    </div>
</div>